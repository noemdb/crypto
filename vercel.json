{
  "build": {
    "env": {
      "TZ": "UTC"
    }
  },
  "env": {
    "TZ": "UTC"
  },
  "crons": [
    {
      "path": "/api/cron/trigger",
      "schedule": "0 0 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "develop": false
    }
  }
}
