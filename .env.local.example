# ── Base de datos (Neon.tech) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js v5 ─────────────────────────────────────────────────────────────
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ── Autenticación — Operador único ────────────────────────────────────────
# Generar hash con: npm run hash-password "tu-contraseña"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD_HASH="$2a$12$..."



# ── Feature Flags ──────────────────────────────────────────────────────────
ENABLE_P2P_SCRAPING="false"
ENABLE_TELEGRAM_ALERTS="false"

# ── App ────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── NVIDIA NIM API ─────────────────────────────────────────────────────────
NVIDIA_API_KEY=""
